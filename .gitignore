# Environments
.env/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Generated outputs -- artifacts/ is the single output location, and its contents are
# reproducible from the code, so they are not tracked.
artifacts/*
!artifacts/.gitkeep

# This repository tracks the implementation only. The paper source, the reading notes
# extracted from it, the decision records and the session logs all stay on local disk --
# they are working material, not part of the published reproduction.
docs/
paper.md
*.pdf
AGENTS.md
CLAUDE.md
CONTEXT.md
PROGRESS.md
block1_progress.md
reviews.md

# Agent tooling and scratch space
.claude/
.agents/
skills-lock.json
.scratch/

# OS / editor
.DS_Store
*.swp
