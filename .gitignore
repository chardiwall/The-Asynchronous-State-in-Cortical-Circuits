# Environments
.env/
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Generated outputs — data/raw is tracked as read-only source, these are not
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep

.claude/


# Large raw datasets (N-MNIST, DVS-Gesture) — keep the directory, not the contents
data/raw/*
!data/raw/.gitkeep

# Paper source and personal reading notes — local reference only, not tracked.
# Project scaffolding (CLAUDE.md, AGENTS.md, CONTEXT.md, PROGRESS.md, reviews.md,
# README.md, docs/adr/*.md) stays tracked — it's read by future sessions/collaborators.
*.pdf
paper.md
docs/paper/*.md
AGENTS.md
CLAUDE.md
CONTEXT.md
PROGRESS.md
reviews.md

# OS / editor
.DS_Store
*.swp
